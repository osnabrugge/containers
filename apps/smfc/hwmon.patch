+    def _fresh_smartctl_temperature(self, index: int) -> float:
+        """Read a bounded, uncached fallback without changing the selected HWMON source."""
+        result = self._exec_smartctl(["-A", "-j", self.hd_device_names[index]], timeout=5)
+        if result.returncode & 0x07:
+            raise OSError("smartctl could not complete its temperature read")
+        temperature = json.loads(result.stdout)["temperature"]["current"]
+        if type(temperature) not in (int, float) or not 0 < temperature < 150:
+            raise ValueError("smartctl returned an invalid temperature")
+        return float(temperature)
